<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.Pages.CalculatorPage"
             Title="Calculator">
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="DarkGray" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="OpButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="LightGray" />
        </Style>
        <Style x:Key="FuncButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="LightBlue" />
        </Style>
    </ContentPage.Resources>
    
    <!-- Layout 1 : Grid racine -->
    <Grid RowDefinitions="*,2*" Padding="12" RowSpacing="8">
        <!--Layout 2 : border -->
        <Border Grid.Row="0" BackgroundColor="LightGray" Padding="16" 
                StrokeShape="RoundRectangle 20" StrokeThickness="0">
            <!-- Layout 3 : verticalstacklayout -->
            <VerticalStackLayout VerticalOptions="End" Spacing="4">
                <Label x:Name="ExpressionLabel" Text="" FontSize="20" 
                       TextColor="Black" HorizontalOptions="End" LineBreakMode="HeadTruncation" />
                <!-- Layout 4 : scrollview horizontal -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <Label x:Name="ResultLabel" Text="" FontSize="56" 
                           TextColor="Black" HorizontalOptions="End" LineBreakMode="HeadTruncation" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>
        <!-- Clavier : Grid 5 lignes x 4 colonnes -->
        <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*" Padding="12" RowSpacing="8" ColumnSpacing="8">
            <Button Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource FuncButton}" Clicked="OnClear" />
            <Button Grid.Row="0" Grid.Column="1" Text="Del" Style="{StaticResource FuncButton}" Clicked="OnBackspace" />
            <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource FuncButton}" Clicked="OnPercent"/>
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource OpButton}" Clicked="OnOperator" />
            
            <Button Grid.Row="1" Grid.Column="0" Text="7" Clicked="OnDigit"/>
            <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnDigit"/>
            <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="OnDigit"/>
            <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource OpButton}" Clicked="OnOperator" />
            
            <Button Grid.Row="2" Grid.Column="0" Text="4" Clicked="OnDigit"/>
            <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnDigit"/>
            <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="OnDigit"/>
            <Button Grid.Row="2" Grid.Column="3" Text="-" Style="{StaticResource OpButton}" Clicked="OnOperator" />
            
            <Button Grid.Row="3" Grid.Column="0" Text="1" Clicked="OnDigit"/>
            <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnDigit"/>
            <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="OnDigit"/>
            <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource OpButton}" Clicked="OnOperator" />
            
            <Button Grid.Row="4" Grid.Column="0" Text="±" Clicked="OnSign" />
            <Button Grid.Row="4" Grid.Column="1" Text="0" Clicked="OnDigit"/>
            <Button Grid.Row="4" Grid.Column="2" Text="." Clicked="OnDecimal"/>
            <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource OpButton}" Clicked="OnEquals"/>
        </Grid> 
    </Grid>
</ContentPage>